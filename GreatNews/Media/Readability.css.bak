div.gn_pager
{
	font-size: 10px;
	font-family: 'Arial Black' , Arial;
	text-align: right;
	margin: 10px;
}
span.gn_pagenumber
{
	padding-right: 2px;
	padding-left: 2px;
	color: white;
	background-color: gray;
}
a.gn_pagerlink
{
	color: blue;
}
body
{
	padding-right: 10px;
	padding-left: 10px;
	padding-bottom: 10px;
	margin: 0px;
	padding-top: 10px;
	background-color: #ffffff;
}
img {
	border: 0px;
	max-width: 100%;
}


div.gn_channeltitle
{
	border-top-width: 1px;
	font-weight: bold;
	border-left-width: 1px;
	font-size: 26px;
	border-bottom-width: 1px;
	border-bottom-color: #333;
	padding-bottom: 2px;
	margin: 10px 10px 0px;
	border-top-color: #333;
	padding-top: 2px;
	font-family: Arial;
	text-align: right;
	border-right-width: 1px;
}
                               
div.gn_channeldesc
{
	font-weight: normal;
	font-size: 14px;
	margin: 10px;
	font-family: 'Courier New';
	text-align: right;
}
div.gn_channeltitle a
{
	color: black;
	text-decoration: none;
}
div.gn_channeltitle a:hover
{
	text-decoration: underline;
}                
div.gn_channelimage
{
	visibility: hidden;
	margin: 10px;
	height: 0px;
	text-align: center;
}

a.gn_storytitle
{
	text-decoration: none;
}

div.gn_story, div.gn_stories
{
	clear: none;
	padding-left: 5px;
	margin: 4px 10px 20px;
	vertical-align: top;
	overflow: visible;
	border-right: 15px ridge;
	width: 98%;
	padding: 4px;
}

div.gn_storytitle
{
	clear: both;
	font-weight: bold;
	font-size: 18px;
	margin-bottom: 10px;
	width: 98%;
	font-family: Arial, sans-serif;
}

div.gn_storydetails,td
{
	clear: none;
	font-size: 14px;
	float: left;
	overflow: visible;
	color: #333;
	font-family: Arial, sans-serif;
}
                          
div.gn_storyfooter
{
	clear: both;
	margin-top: 15px;
	font-size: 11px;
	width: 98%;
	font-family: Verdana, sans-serif;
	text-align: right;
}

span.gn_publishtime, span.noLabel, span.withLabel
{
	color: gray;
	text-align: right;
}

div.comment
{
	margin-top: 15px;
	font-size: 11px;
	font-family: Verdana, Arial, sans-serif;
}

div.comment p
{
	margin: 1px;
}

span.commentTime
{
	color: white;
	border-bottom: 1px solid;
	background-color: gray;
	margin: 1px 10px 1px 1px;
}

body
{
	padding-right: 10px;
	padding-left: 10px;
	padding-bottom: 10px;
	margin: 0px;
	padding-top: 10px;
}
div.gn_pager
{
	clear: both;
	font-size: 10px;
	font-family: 'Arial Black' , Arial;
	text-align: right;
	margin: 10px;
}
span.gn_pagenumber
{
	padding-right: 2px;
	padding-left: 2px;
	color: white;
	background-color: gray;
}
a.gn_pagerlink
{
	color: blue;
}
img {
	border: 0px;
	display: none;
}

div.gn_channeltitle
{
	clear: both;
	border-top: #333 1px solid;
	font-weight: bold;
	font-size: 24px;
	padding-bottom: 2px;
	margin: 5px;
	padding-top: 2px;
	border-bottom: #333 1px solid;
	font-family: 'Lucida Grande', Geneva, Arial, Verdana, sans-serif;
	background-color: #f8f8f8;
	width: 100%
}
div.gn_channeltitle a
{
	color: black;
	text-decoration: none;
}
div.gn_channeltitle a:hover
{
	text-decoration: underline;
}
                               
div.gn_channeldesc
{
	display: none;
}
                
div.gn_channelimage
{
	display: none;
}

div.gn_story, div.gn_stories
{
	border-top: #999 1px solid;
	margin: 0.5%;
	vertical-align: top;
	padding: 4px;
	font-family: 'Lucida Grande', Geneva, Arial, Verdana, sans-serif;
}

div.gn_story
{
	width: 98%;
}

div.gn_stories
{
	width: 48%;
	float: left;
	overflow: hidden;
}

div.gn_storytitle
{
	font-weight: bold;
	font-size: 14px;
	margin-bottom: 10px;
}
a.gn_storytitle
{
	text-decoration: none;
}
a.gn_storytitle:hover
{
	text-decoration: underline;
}
div.gn_storydetails,td
{
	font-size: 12px;
	color: #333;
}
div.gn_stories div.gn_storydetails
{
	height: 30px;
	overflow: hidden;
}
                          
div.gn_storyfooter
{
	clear: both;
	margin-top: 15px;
	font-size: 11px;
}

span.gn_publishtime, span.noLabel, span.withLabel
{
	color: gray;
	text-align: left;
}

div.comment
{
	margin-top: 15px;
	font-size: 11px;
	font-family: Verdana, Arial, sans-serif;
}

div.comment p
{
	margin: 1px;
}

span.commentTime
{
	color: white;
	border-bottom: 1px solid;
	background-color: gray;
	margin: 1px 10px 1px 1px;
}

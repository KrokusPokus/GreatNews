        MENUITEM "Search Next\tF3",             ID_EDIT_FINDNEXT
        MENUITEM "Global Search",               ID_EDIT_GLOBALSEARCH
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Channel &Bar",                ID_VIEW_CHANNELBAR
        MENUITEM "News &List",                  ID_VIEW_NEWSLIST
        POPUP "Reading Pane"
        BEGIN
            MENUITEM "Bottom",                      ID_READINGPANE_BOTTOM
            MENUITEM "Right",                       ID_READINGPANE_RIGHT
        END
        MENUITEM SEPARATOR
        MENUITEM "New &Tab\tCtrl+T",            ID_VIEW_NEWTAB
        MENUITEM "&Maximize Reading Pane\tF12", ID_VIEW_MAXIMIZEBROWSER
        MENUITEM SEPARATOR
        MENUITEM "Next Unread &Channel\tF7",    ID_VIEW_NEXTUNREADNEWS
        MENUITEM "Next Unread &Group\tF8",      ID_VIEW_NEXTUNREADGROUP
        MENUITEM "&Next News Item",             ID_IE_NEXT
        MENUITEM "&Previous News Item",         ID_IE_PREV
        MENUITEM SEPARATOR
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Import Channels From OPML/XML File...", ID_TOOLS_IMPORT
        MENUITEM "&Export Channels To OPML/XML File...", ID_TOOLS_EXPORT
        MENUITEM "Export News To &RSS/XML File...", ID_TOOLS_EXPORTNEWSLIST
        MENUITEM "&Cleanup...",                 ID_TOOLS_CLEANUP
        MENUITEM SEPARATOR
        POPUP "Channel Statistics"
        BEGIN
            MENUITEM "Most Visited",                ID_TOOLS_MOST10
            MENUITEM "Least Visited",               ID_TOOLS_LEAST10
            MENUITEM "Most Active In Last 60 Days", ID_TOOLS_MOSTACTIVE
            MENUITEM "Least Active In Last 60 Days", ID_TOOLS_LEASTACTIVE
            MENUITEM SEPARATOR
            MENUITEM "Config...",                   ID_TOOLS_CONFIGSTATISTICS
        END
        MENUITEM SEPARATOR
        MENUITEM "Options...",                  ID_TOOLS_OPTIONS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Visit GreatNews &Website...", ID_HELP_VISITGREATNEWS
        MENUITEM "Visit GreatNews &Forum...",   ID_HELP_VISITFORUM
        MENUITEM SEPARATOR
        MENUITEM "&About...",                   ID_APP_ABOUT
    END
END


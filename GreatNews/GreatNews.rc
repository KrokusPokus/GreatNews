IDD_ABOUTBOX DIALOGEX 0, 0, 251, 186
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,195,165,50,14
    LTEXT           "BuildNumber",IDC_BUILDNUM,68,10,143,8
    LTEXT           "Data file version:",IDC_DBVER,68,20,144,8
    CONTROL         253,IDC_ABOUTIMAGE,"Static",SS_BITMAP | SS_REALSIZEIMAGE,0,0,63,185
    LTEXT           "Copyright © 2004-2011",IDC_URL2,68,31,74,8
    LTEXT           "Static",IDC_CREDIT,68,77,176,83
    LTEXT           "Graphic Design by ",IDC_STATIC,68,60,61,8
    LTEXT           "Mercury_C",IDC_GRAPHIC,129,60,35,8
    LTEXT           "Curio Studio",IDC_URL,188,31,39,8
    LTEXT           "Jack Pan",IDC_CONTACTS,145,31,31,8
    LTEXT           "@",IDC_STATIC,178,31,8,8
END

IDD_FEED_GROUP DIALOGEX 0, 0, 302, 155
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Group Properties"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Group Name(*):",IDS_GROUPNAME,7,17,52,8
    EDITTEXT        IDC_GROUP_NAME,61,15,143,14,ES_AUTOHSCROLL
    RTEXT           "Description:",IDS_DESC,20,34,39,8
    EDITTEXT        IDC_GROUP_DESC,62,34,233,37,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN
    RTEXT           "Group Website:",IDS_WEBSITE,8,78,51,8
    EDITTEXT        IDC_GROUP_WEBSITE,61,76,143,14,ES_AUTOHSCROLL
    CONTROL         "Do not update this channel group automatically",IDC_CHKDISABLE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,102,167,10
    LTEXT           "Num Of Item:",IDC_NUMOFITEM,7,121,288,8,NOT WS_VISIBLE
    DEFPUSHBUTTON   "OK",IDOK,188,134,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,245,134,50,14
END

IDD_OPTION_GENERAL DIALOGEX 0, 0, 290, 230
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Update all channels when GreatNews starts",IDC_UPDATECHANNELATSTARTUP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,7,155,10
    CONTROL         "Minimize to system tray",IDC_REMOVEFROMTASKBAR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,19,91,10
    CONTROL         "Close to system tray",IDC_CHKCLOSETOTRAY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,32,82,10
    CONTROL         "Automatically update all news channels every ",IDS_UPDATECHANNELEVERY,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,44,158,10
    COMBOBOX        IDC_AUTOUPDATE_FREQ,169,43,46,65,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Delete GreatNews temp files upon exit",IDC_DELTEMPWHENEXIT,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,58,139,10
    LTEXT           "Remind me to run Cleanup Wizard every ",IDS_REMINDCLEANUPEVERY,7,74,132,8
    COMBOBOX        IDC_CLEANUPREMINDER,140,72,46,65,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "When GreatNews starts",IDS_STARTS,7,90,276,88
    CONTROL         "Show blank screen",IDC_SHOWBLANKSCREEN,"Button",BS_AUTORADIOBUTTON | WS_GROUP,13,102,117,10
    CONTROL         "Show Welcome screen",IDC_SHOWWELCOME,"Button",BS_AUTORADIOBUTTON,13,115,120,10
    CONTROL         "Show top 10 most visited channels",IDC_SHOWTOP10,"Button",BS_AUTORADIOBUTTON,13,129,126,10
    CONTROL         "Show Label",IDC_SHOWLABEL,"Button",BS_AUTORADIOBUTTON,13,144,52,10
    CONTROL         "Show Watch",IDC_SHOWWATCH,"Button",BS_AUTORADIOBUTTON,13,159,56,10
    COMBOBOX        IDC_ALLLABELS,72,142,81,124,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    COMBOBOX        IDC_ALLWATCHES,72,158,81,124,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Set GreatNews as the default feed aggregator",IDC_BTNDEFAULTREADER,7,185,173,14
END

IDD_WATCH_NAME DIALOGEX 0, 0, 298, 231
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Words to Watch(*):",IDS_WATCHWORDS,0,4,65,8
    EDITTEXT        IDC_WATCH_WORDS,67,2,229,14,ES_AUTOHSCROLL

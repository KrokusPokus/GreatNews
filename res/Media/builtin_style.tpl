span.unreaditem
{
	background-position: left center;
	background-image: url(file://%MEDIA%/unread.gif);
	background-repeat: no-repeat;
	vertical-align: top;
	width: 17px;
	height: 11px;
}
span.unreaditem a
{
	text-decoration: none;
}
span.readitem
{
	background-position: left center;
	background-image: url(file://%MEDIA%/read.gif);
	background-repeat: no-repeat;
	vertical-align: top;
	width: 17px;
	height: 11px;
}
span.readitem a
{
	text-decoration: none;
}
span.noLabel, a.noLabel, a.withLabel
{
	text-decoration: underline;
	color: gray;
	cursor: pointer;
}
a.withLabel
{
	padding-left: 15px;
	background-position: left center;
	background-image: url(file://%MEDIA%/label.gif);
	background-repeat: no-repeat;
}
div.gn_podurl
{
	background-position: left center;
	background-image: url(file://%MEDIA%/podcast.gif);
	vertical-align: top;
	background-repeat: no-repeat;
	width: 47px;
	height: 22px;
	cursor: pointer;
}
a.gn_podurl
{
	text-decoration: none;
}

